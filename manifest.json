{
  "manifest_version": 3,
  "name": "Duolingo Russian Word List",
  "version": "1.3.0",
  "description": "Reads the Russian words page on Duolingo, converts every word to its base form (nominative, masculine singular, infinitive), saves word list and guidebook sentences as JSON, and offers flashcards.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "tabs"],
  "host_permissions": [
    "https://www.duolingo.com/*",
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.duolingo.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.duolingo.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Duolingo Russian Word List",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "words.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
